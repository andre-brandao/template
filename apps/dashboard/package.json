{
  "name": "dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "bun run check",
    "test": "bun test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui"
  },
  "dependencies": {
    "@json-render/core": "0.22.0",
    "@json-render/svelte": "0.22.0",
    "@lucide/svelte": "^1.73.0",
    "@openauthjs/openauth": "catalog:",
    "@tanstack/ai": "^1.4.0",
    "@tanstack/ai-mcp": "^1.2.0",
    "@tanstack/ai-openai": "^1.1.1",
    "@tanstack/ai-svelte": "^1.0.0",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/svelte-hotkeys": "catalog:frontend",
    "@tanstack/svelte-query": "catalog:frontend",
    "@tanstack/svelte-table": "^9.3.2",
    "@template/core": "workspace:*",
    "@template/functions": "workspace:*",
    "@template/sdk": "workspace:*",
    "@template/ui": "workspace:*",
    "d3-scale": "^4.0.3",
    "sst": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:testing",
    "@sveltejs/adapter-bun": "^1.0.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-node": "catalog:frontend",
    "@sveltejs/kit": "catalog:frontend",
    "@sveltejs/vite-plugin-svelte": "catalog:frontend",
    "@tanstack/query-devtools": "catalog:frontend",
    "@tanstack/svelte-devtools": "catalog:frontend",
    "@tanstack/svelte-hotkeys-devtools": "catalog:frontend",
    "@types/bun": "catalog:",
    "@types/d3-scale": "^4.0.9",
    "svelte": "catalog:frontend",
    "svelte-check": "catalog:frontend",
    "typescript": "^6.0.3",
    "vite": "catalog:frontend",
    "wrangler": "^4.118.0"
  }
}
