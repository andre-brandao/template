{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@dev-template",
  "private": true,
  "workspaces": {
    "catalog": {
      "@openauthjs/openauth": "0.4.3",
      "@types/bun": "1.3.13",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "hono": "^4.13.18",
      "postgres": "^4.1.1",
      "sst": "4.17.1",
      "typescript": "^7.0.2",
      "ulid": "^3.0.2",
      "zod": "^4.6.7"
    },
    "catalogs": {
      "build": {
        "@hey-api/openapi-ts": "0.99.0"
      },
      "frontend": {
        "@sveltejs/adapter-auto": "^8.0.1",
        "@sveltejs/adapter-node": "^6.0.2",
        "@sveltejs/kit": "^3.2.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tanstack/query-devtools": "5.107.1",
        "@tanstack/svelte-devtools": "0.1.8",
        "@tanstack/svelte-hotkeys": "0.24.1",
        "@tanstack/svelte-hotkeys-devtools": "0.5.10",
        "@tanstack/svelte-query": "^6.4.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "vite": "^8.3.8"
      },
      "testing": {
        "@happy-dom/global-registrator": "^20.14.6",
        "@playwright/test": "^1.65.1",
        "@testing-library/svelte": "^5.4.2"
      }
    },
    "packages": [
      "packages/*",
      "packages/sdk/ts",
      "apps/*",
      "scripts",
      "infra/alchemy"
    ]
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules **/node_modules",
    "cli": "bun run apps/cli/src/index.ts",
    "dev": "bun run scripts/dev.ts",
    "docker": "docker compose -f infra/docker/compose.yml",
    "docker:up": "test -f infra/docker/.env || cp infra/docker/.env.example infra/docker/.env; docker compose -f infra/docker/compose.yml up --build -d",
    "docker:logs": "docker compose -f infra/docker/compose.yml logs -f",
    "docker:down": "docker compose -f infra/docker/compose.yml down",
    "fallow": "bunx fallow health --hotspots --top 3 && bunx fallow dead-code && bunx fallow dupes",
    "fallow:dead-code": "bunx fallow dead-code",
    "fallow:dupes": "bunx fallow dupes",
    "fallow:health": "bunx fallow health --hotspots --top 3",
    "fallow:json": "bunx fallow health --hotspots --top 3 --format json --quiet && bunx fallow dead-code --format json --quiet && bunx fallow dupes --format json --quiet",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen": "bun run --filter '@template/functions' gen:spec && bun run --filter '@template/sdk' gen && bun run fmt",
    "lint": "oxlint",
    "lint:ci": "oxlint -f github",
    "lint:fix": "oxlint --fix",
    "prototype": "bun run scripts/prototype.ts",
    "test": "bun --filter '*' test",
    "test:ci": "bun --filter '*' test --reporter=junit --reporter-outfile=junit.xml --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:e2e": "bun run --filter dashboard test:e2e",
    "typecheck": "bun --filter '*' typecheck"
  },
  "dependencies": {
    "sst": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260715.1",
    "@types/bun": "catalog:",
    "fallow": "^3.43.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
