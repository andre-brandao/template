{
  "name": "@template/core",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "module": "index.ts",
  "exports": {
    "./*": "./src/*/index.ts",
    "./actor": "./src/actor.ts",
    "./common": "./src/common.ts",
    "./context": "./src/context.ts",
    "./error": "./src/error.ts",
    "./examples": "./src/examples.ts",
    "./identifier": "./src/identifier.ts",
    "./jobs": "./src/jobs.ts",
    "./permission": "./src/permission.ts",
    "./drizzle/*": "./src/drizzle/*.ts",
    "./email": "./src/lib/email/index.ts",
    "./email/*": "./src/lib/email/*.ts",
    "./queue": "./src/lib/queue/index.ts",
    "./queue/*": "./src/lib/queue/*.ts",
    "./storage": "./src/lib/storage/index.ts",
    "./storage/*": "./src/lib/storage/*.ts",
    "./user/*": "./src/user/*.ts",
    "./admin": "./src/platform/admin/index.ts",
    "./event": "./src/platform/event/index.ts",
    "./health": "./src/platform/health/index.ts",
    "./key": "./src/platform/key/index.ts",
    "./key/*": "./src/platform/key/*.ts",
    "./webhook": "./src/platform/webhook/index.ts",
    "./webhook/*": "./src/platform/webhook/*.ts",
    "./util/*": "./src/util/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
