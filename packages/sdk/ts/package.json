{
  "name": "@template/sdk",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./core": "./src/core/index.ts",
    "./query": "./src/index.ts",
    "./*": "./src/*.ts"
